# Zanbeel production settings, read by deploy.sh, deploy/setup-system.sh and
# deploy/ecosystem.config.js. Change a value, then run ./deploy.sh again.

# The one public port. nginx serves the web app here and passes /api to the backends,
# so the browser, the fox CLI and the VS Code extension all use this address.
# (5173 and 33333 belong to the older FoxNest install on this server.)
ZANBEEL_PUBLIC_PORT=8090

# The backend instances nginx balances across: one per port, each run by PM2.
# They listen on 127.0.0.1 only, so nothing reaches them except through nginx.
# Add or remove a port to scale.
ZANBEEL_API_PORTS="8091 8092 8093 8094"

# Where nginx serves the production build from. Each deploy is a new folder under
# releases/, and "current" points at the live one.
ZANBEEL_WEB_ROOT=/var/www/zanbeel

# nginx server_name. "_" answers on any host name or address.
ZANBEEL_SERVER_NAME=_

# HTTPS on the public port. deploy/setup-system.sh makes a self-signed certificate and
# key here when there are none, and makes it again when a self-signed one is about to
# expire. To use a CA-issued certificate instead, put its full chain and key at these
# paths (or point these at them).
ZANBEEL_TLS_CERT=/etc/nginx/ssl/zanbeel.crt
ZANBEEL_TLS_KEY=/etc/nginx/ssl/zanbeel.key

# The address users, the fox CLI and the VS Code extension connect to. The server puts it
# in the CLI quick start that new collaborators are sent.
ZANBEEL_PUBLIC_URL=https://192.168.15.207:8090
