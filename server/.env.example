# Environment variables for Zanbeel / FoxNest
# Copy to .env and fill in real values. Do NOT commit .env.

DATABASE_URL=sqlite:///./foxnest.db
# DATABASE_URL=postgresql://user:password@localhost/foxnest_db

SERVER_HOST=0.0.0.0
SERVER_PORT=33333
DEBUG=False

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama model names (not weight files)
FOXNEST_PROJECT_DOCS_MODEL=qwen2.5-coder:7b
FOXNEST_DOCS_MODEL=qwen2.5-coder:7b

# REQUIRED: replace with long random values (python -c "import secrets; print(secrets.token_urlsafe(48))")
# Known placeholders like "change-me-to-a-long-random-string" will refuse to start the server.
FOXNEST_AUTH_SECRET=
FOXNEST_TOKEN_EXPIRY_HOURS=12
FOXNEST_PASSWORD_SETUP_KEY=

# Local-only escape hatch (never enable on shared/network hosts)
# FOXNEST_ALLOW_INSECURE_AUTH=1

# --- Push admission limits -------------------------------------------------
# Per-file and per-push caps in MB. Set to 0 to disable a check.
# These keep installers, release archives and build output out of the object store.
FOXNEST_MAX_FILE_MB=50
FOXNEST_MAX_PUSH_MB=250

# Enforce the repository's .foxignore server-side (1/0). Leave on: a stale or
# patched client must not be able to smuggle build output into the store.
FOXNEST_ENFORCE_IGNORE=1

# --- Blob storage ----------------------------------------------------------
# File contents live on disk, content-addressed, instead of inline in the
# database. Point this at a data volume in production; back it up alongside
# the database, since the two are only meaningful together.
# Default: <server>/blobstore
# FOXNEST_BLOB_DIR=/var/lib/foxnest/blobstore

# Log every SQL statement (very noisy; also writes bound parameters to the log).
# Leave off in production. FOXNEST_SQL_ECHO=1 to enable while debugging.
# FOXNEST_SQL_ECHO=0
