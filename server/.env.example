# Environment variables for Zanbeel / FoxNest
# Copy to .env and fill in real values. Do NOT commit .env.

DATABASE_URL=sqlite:///./foxnest.db
# DATABASE_URL=postgresql://user:password@localhost/foxnest_db

SERVER_HOST=0.0.0.0
SERVER_PORT=33333
DEBUG=True

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama model names (not weight files)
FOXNEST_PROJECT_DOCS_MODEL=qwen2.5-coder:7b
FOXNEST_DOCS_MODEL=qwen2.5-coder:7b

# Generate your own secrets for production
FOXNEST_AUTH_SECRET=change-me-to-a-long-random-string
FOXNEST_TOKEN_EXPIRY_HOURS=12
FOXNEST_PASSWORD_SETUP_KEY=change-me-to-another-random-string
