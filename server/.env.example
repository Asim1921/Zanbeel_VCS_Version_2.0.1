# Environment variables for Zanbeel / FoxNest
# Copy to .env and fill in real values. Do NOT commit .env.

DATABASE_URL=sqlite:///./foxnest.db
# DATABASE_URL=postgresql://user:password@localhost/foxnest_db

SERVER_HOST=0.0.0.0
SERVER_PORT=33333
DEBUG=False

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama model names (not weight files)
FOXNEST_PROJECT_DOCS_MODEL=qwen2.5-coder:7b
FOXNEST_DOCS_MODEL=qwen2.5-coder:7b
# Where Ollama listens, if not on this machine. Default: http://localhost:11434
# FOXNEST_OLLAMA_URL=http://gpu-host:11434
# Where generated documentation is kept, one folder per repository.
# Default: /tmp/foxnest_server/docs (on Windows, \tmp\foxnest_server\docs on the
# server's drive). Point it at a data volume: /tmp is not kept across reboots.
# FOXNEST_DOCS_DIR=/var/lib/foxnest/docs
# The document templates the generator follows. Default: <repo>/docs/templates
# FOXNEST_DOCS_TEMPLATES_DIR=/opt/foxnest/docs/templates

# REQUIRED: replace with long random values (python -c "import secrets; print(secrets.token_urlsafe(48))")
# Known placeholders like "change-me-to-a-long-random-string" will refuse to start the server.
FOXNEST_AUTH_SECRET=
FOXNEST_TOKEN_EXPIRY_HOURS=12
FOXNEST_PASSWORD_SETUP_KEY=

# Lifetime of the token an SSH-key sign-in returns. Short is fine: the CLI renews
# it by signing a fresh challenge with the same key. Removing the key ends it at once.
FOXNEST_SSH_SESSION_HOURS=8

# Local-only escape hatch (never enable on shared/network hosts)
# FOXNEST_ALLOW_INSECURE_AUTH=1

# --- Integrations: where the server may send requests ----------------------
# Webhooks and push-rule policy services are called only at public addresses.
# Loopback (this server itself), link-local (including the cloud metadata
# service, 169.254.169.254), private networks and reserved ranges are refused,
# both when the URL is saved and again on every delivery.
# To reach an internal receiver, allow it here, comma-separated: host names,
# *.suffix wildcards, IP addresses or CIDR ranges.
# FOXNEST_OUTBOUND_ALLOWED_HOSTS=ci.internal.example,*.corp.example,10.20.0.0/16
# Or allow every private-network address. Loopback and link-local stay refused
# unless listed above.
# FOXNEST_OUTBOUND_ALLOW_PRIVATE=0

# Webhook delivery log: rows older than this many days are pruned, and each
# hook keeps at most this many.
FOXNEST_WEBHOOK_RETENTION_DAYS=30
FOXNEST_WEBHOOK_MAX_DELIVERIES=500
# Deliveries run on a fixed pool of this many worker threads.
FOXNEST_WEBHOOK_WORKERS=8

# --- Discovery: search, the activity log, notifications --------------------
# The address clients should use for this server, used in the CLI quick start
# sent to new collaborators. Without it, the address the request came in on.
# FOXNEST_PUBLIC_URL=https://vcs.example.org

# Code search indexes the text on every repository's default branch, in its own
# SQLite file. It holds nothing that cannot be rebuilt from the object store:
# safe to delete, not worth backing up. Set FOXNEST_SEARCH_INDEX=0 to turn it off
# (code search then covers one repository at a time).
# FOXNEST_SEARCH_INDEX=1
# FOXNEST_SEARCH_INDEX_PATH=/var/lib/foxnest/search_index.db
# Time limit, in seconds, for a search that scans files (a regular expression,
# or a branch other than the default).
# FOXNEST_SEARCH_SCAN_SECONDS=3

# The activity log is kept forever. Set a number of days to prune older rows at
# startup.
# FOXNEST_ACTIVITY_RETENTION_DAYS=0

# --- Push admission limits -------------------------------------------------
# Per-file and per-push caps in MB. Set to 0 to disable a check.
# These keep installers, release archives and build output out of the object store.
FOXNEST_MAX_FILE_MB=50
FOXNEST_MAX_PUSH_MB=250

# Enforce the repository's .foxignore server-side (1/0). Leave on: a stale or
# patched client must not be able to smuggle build output into the store.
FOXNEST_ENFORCE_IGNORE=1

# --- Blob storage ----------------------------------------------------------
# File contents live on disk, content-addressed, instead of inline in the
# database. Point this at a data volume in production; back it up alongside
# the database, since the two are only meaningful together.
# Default: <server>/blobstore
# FOXNEST_BLOB_DIR=/var/lib/foxnest/blobstore

# Log every SQL statement (very noisy; also writes bound parameters to the log).
# Leave off in production. FOXNEST_SQL_ECHO=1 to enable while debugging.
# FOXNEST_SQL_ECHO=0

# A server configured for PostgreSQL refuses to start when it cannot connect,
# rather than quietly using an empty local SQLite file. Development only:
# FOXNEST_ALLOW_SQLITE_FALLBACK=1

# --- Sign-in limits ---------------------------------------------------------
# Failures from one address for one account, within the window, before that
# address is refused for that account (the owner elsewhere is unaffected).
# FOXNEST_LOGIN_MAX_FAILURES=5
# FOXNEST_LOGIN_WINDOW_MINUTES=15
# Failures for one account from anywhere before the account itself is locked.
# Each consecutive lock lasts twice as long as the last, up to the maximum.
# FOXNEST_LOGIN_MAX_ACCOUNT_FAILURES=20
# FOXNEST_LOGIN_LOCKOUT_MINUTES=15
# FOXNEST_LOGIN_MAX_LOCKOUT_MINUTES=1440
# Failures from one address across all accounts before that address is throttled.
# FOXNEST_LOGIN_MAX_IP_FAILURES=20
# FOXNEST_LOGIN_IP_WINDOW_MINUTES=15
# Wrong password-reset codes per account per hour, across every code issued, and
# reset codes requested from one address per window.
# FOXNEST_OTP_MAX_ACCOUNT_FAILURES=10
# FOXNEST_RESET_MAX_REQUESTS_PER_IP=10
# Attempt history kept for the lockout view.
# FOXNEST_LOGIN_RETENTION_HOURS=24
# Behind a reverse proxy, take the client address from X-Forwarded-For. Only set
# this when every request does come through the proxy: otherwise a client can
# claim any address and step around the per-address limits.
# FOXNEST_TRUST_PROXY=0

# --- Backups ----------------------------------------------------------------
# Where backups are written. Default: a "backups" folder beside the blob store.
# Put it on another disk: a backup on the same disk as the data does not survive
# losing that disk (the Operations page says so when they share one).
# FOXNEST_BACKUP_DIR=/mnt/backup/zanbeel
# Take a verified backup every N hours (0 = off). Each is restore-drilled after
# it is taken unless FOXNEST_BACKUP_TEST_RESTORE=0. 24 is usual.
# FOXNEST_BACKUP_INTERVAL_HOURS=0
# FOXNEST_BACKUP_TEST_RESTORE=1
# Verified backups kept; older ones are removed after each new verified backup.
# Unchanged blobs are hard-linked between backups, so each costs only what changed.
# FOXNEST_BACKUP_KEEP=7
# The Operations page flags the newest verified backup as stale after this long.
# FOXNEST_BACKUP_STALE_HOURS=48

# --- Schema migrations ------------------------------------------------------
# The server applies pending migrations when it starts, in one transaction, after
# copying the database to <backup dir>/pre-upgrade. Set to 0 to apply them
# yourself first (tools/schema.py --upgrade); the server then refuses to start
# while any are pending.
# FOXNEST_AUTO_MIGRATE=1
# Pre-upgrade copies kept.
# FOXNEST_UPGRADE_SNAPSHOTS_KEEP=5
# Start even though the schema does not match what the code queries. Only after
# reading what tools/schema.py --check reports.
# FOXNEST_ALLOW_SCHEMA_DRIFT=0
